{
  "name": "contract-ledger-workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "合同管理台账工作台（Vue 3 + Element Plus，构建为单文件产物）",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node scripts/check-singlefile.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "validate": "node scripts/check-runtime.mjs && tsc -b --pretty false && vitest run"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.8",
    "vue": "^3.5.45",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "execa": "10.0.0",
    "kysely-codegen": "0.20.0",
    "typescript": "5.9.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "5.1.0"
  }
}
